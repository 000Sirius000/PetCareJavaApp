<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pet_background"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/section_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Weight"
        android:textColor="@color/pet_text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/section_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Weight trend chart and measurement log"
        android:textColor="@color/pet_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_week"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Week" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/button_month"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Month" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/button_year"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Year" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/button_previous_period"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_chart_navigation"
            android:contentDescription="@string/chart_previous_period"
            android:padding="12dp"
            android:src="@drawable/ic_chart_previous"
            app:tint="@color/chart_navigation_icon" />

        <TextView
            android:id="@+id/period_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/pet_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/button_next_period"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_chart_navigation"
            android:contentDescription="@string/chart_next_period"
            android:padding="12dp"
            android:src="@drawable/ic_chart_next"
            app:tint="@color/chart_navigation_icon" />
    </LinearLayout>

    <com.example.petcare.ui.common.WeightChartView
        android:id="@+id/weight_chart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:contentDescription="Weight history chart" />

    <Button
        android:id="@+id/button_add_weight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Add weight measurement" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/weight_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:nestedScrollingEnabled="false" />

    <TextView
        android:id="@+id/weight_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No weight entries yet"
        android:textColor="@color/pet_text_secondary"
        android:visibility="gone" />
</LinearLayout>
</androidx.core.widget.NestedScrollView>
