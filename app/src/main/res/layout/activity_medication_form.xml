<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:title="Medication" />


<com.google.android.material.textfield.TextInputLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/input_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Medication name" />
</com.google.android.material.textfield.TextInputLayout>

<Spinner
    android:id="@+id/input_linked_visit"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp" />

<com.google.android.material.textfield.TextInputLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/input_dosage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Dosage" />
</com.google.android.material.textfield.TextInputLayout>

<com.google.android.material.textfield.TextInputLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/input_dosage_unit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Dosage unit" />
</com.google.android.material.textfield.TextInputLayout>

<com.google.android.material.switchmaterial.SwitchMaterial
    android:id="@+id/switch_remind"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:checked="true"
    android:text="Remind me" />

<LinearLayout
    android:id="@+id/reminder_schedule_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Frequency"
        android:textColor="@color/pet_text_secondary"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/input_frequency"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_interval_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_interval_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Every N days"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/button_time_one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Reminder time: 09:00" />

    <Button
        android:id="@+id/button_time_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Second reminder: 21:00"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/custom_weekdays_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/day_monday"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:checked="true"
                android:text="M" />

            <CheckBox
                android:id="@+id/day_tuesday"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:checked="true"
                android:text="T" />

            <CheckBox
                android:id="@+id/day_wednesday"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:checked="true"
                android:text="W" />

            <CheckBox
                android:id="@+id/day_thursday"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:checked="true"
                android:text="T" />

            <CheckBox
                android:id="@+id/day_friday"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:checked="true"
                android:text="F" />

            <CheckBox
                android:id="@+id/day_saturday"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:checked="true"
                android:text="S" />

            <CheckBox
                android:id="@+id/day_sunday"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:checked="true"
                android:text="S" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>

<com.google.android.material.textfield.TextInputLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/input_start_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:hint="Start date" />
</com.google.android.material.textfield.TextInputLayout>

<com.google.android.material.textfield.TextInputLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/input_end_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:hint="End date (optional)" />
</com.google.android.material.textfield.TextInputLayout>

<CheckBox
    android:id="@+id/check_archived"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Archive this medication course" />


        <Button
            android:id="@+id/button_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/save" />



        <Button
            android:id="@+id/button_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/delete"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
